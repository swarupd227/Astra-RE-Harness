<?xml version="1.0" encoding="UTF-8"?>
<!--
  Throw-away POM used at image-build time to pre-populate the local
  Maven repository (~/.m2) with everything a real Spring Boot 3 project
  needs — for the angular-java target stack's backend half, which
  (unlike every other java-spring-family archetype) is NOT
  framework-free.

  Deliberately declares NO explicit version for junit-jupiter/assertj-
  core/mockito-core — spring-boot-starter-test's own dependency-
  management BOM picks those (3.2.5's BOM manages assertj-core at
  3.24.2 and mockito-core at 5.7.0, for example). This project exists
  SEPARATELY from ../warmup/pom.xml specifically so those two version
  sets never collide: declaring both in one POM makes Maven's nearest-
  wins dependency mediation favour the OTHER project's explicit pins,
  so the versions Spring's BOM actually resolves here never get cached
  — confirmed by a live "mvn -o test-compile" failure against the real
  angular-java archetype before this was split out.

  These dependency declarations MUST mirror angular-java/canonical-
  cpp-widget-crud/backend/pom.xml exactly (same parent version, same
  starters, no extra overrides) so this warmup genuinely caches what
  that archetype — and anything scaffolded from it — actually needs.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>com.example.warmup</groupId>
    <artifactId>maven-sidecar-warmup-spring</artifactId>
    <version>0.0.1</version>
    <packaging>jar</packaging>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- Same plugin versions as ../warmup/pom.xml and the archetype's
             own pom.xml — must stay pinned for the same offline-build
             reason (see those files' comments). -->
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
            </plugin>
        </plugins>
    </build>
</project>

<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Astra.Api</RootNamespace>
    <AssemblyName>Astra.Api</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- EF Core + Postgres -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.10" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.10" />

    <!-- MediatR + FluentValidation -->
    <PackageReference Include="MediatR" Version="12.4.1" />
    <PackageReference Include="FluentValidation" Version="11.10.0" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="11.10.0" />

    <!-- MinIO (S3-compatible blob store) -->
    <PackageReference Include="Minio" Version="6.0.3" />

    <!-- Serilog -->
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />

    <!-- OpenTelemetry -->
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.10.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.10.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.10.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.10.0" />

    <!-- gRPC client for the Fortran parser sidecar (Phase C.2) -->
    <PackageReference Include="Google.Protobuf" Version="3.28.3" />
    <PackageReference Include="Grpc.Net.Client" Version="2.66.0" />
    <PackageReference Include="Grpc.Tools" Version="2.66.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>

    <!-- libgit2sharp for the Git-URL ingest path (Phase C.1) -->
    <PackageReference Include="LibGit2Sharp" Version="0.30.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Generate ParserClient + message types from the mirrored proto.
         Source of truth: app/parser-sidecar/proto/parser.proto. -->
    <Protobuf Include="Parser/parser.proto" GrpcServices="Client" />
  </ItemGroup>

  <ItemGroup>
    <!-- Externalized spec schemas (Phase #3a). One JSON file per source
         language. The Web SDK already includes them as Content by default
         — we just have to flip CopyToOutputDirectory so they ship next
         to the binary. -->
    <Content Update="Llm/Schemas/*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Externalized prompt asset library (Phase #3b). Versioned markdown
         under Llm/Prompts/<sourceSchema>/<targetStack>/<kind>.v<N>.md.
         Markdown isn't part of the SDK's default Content glob, so we
         add them explicitly here. -->
    <Content Include="Llm/Prompts/**/*.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Externalized scaffold archetypes (Phase #3c). Each archetype is a
         directory of template files (.cs, .java, .xml, etc.) plus an
         archetype.json. These are *template* content shipped with the
         binary — they must NOT be compiled as part of the API.

         The Web SDK auto-includes **/*.json as Content already, so we
         only Include the non-json files (and Update the json ones to
         set CopyToOutputDirectory). Compile / EmbeddedResource / None
         are stripped so the SDK doesn't try to treat .cs / .java
         templates as compilable. -->
    <!-- The ArchetypeRegistry / loader code lives at Llm/ArchetypeRegistry.cs
         (outside this tree) so the entire Llm/Archetypes/ subtree is templates. -->
    <Compile Remove="Llm/Archetypes/**" />
    <EmbeddedResource Remove="Llm/Archetypes/**" />
    <None Remove="Llm/Archetypes/**" />
    <!-- Remove SDK-auto-included Content (e.g. archetype.json) so we own
         the include set; otherwise the Include below double-adds them. -->
    <Content Remove="Llm/Archetypes/**" />
    <Content Include="Llm/Archetypes/**/*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Phase 6.0 — Golden dataset entries.
         Per-schema directories of JSON manifests under
         Llm/GoldenDataset/<schemaId>/<entryId>.json. Same shape as the
         archetype tree: ship as Content, don't compile. -->
    <Content Update="Llm/GoldenDataset/**/*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Phase 10.0.h — VB6 Inventory Sample seed corpus.
         The Nous-authored .bas / .cls / .frm sources ship next to the
         API binary so Vb6DemoSeed.SeedAsync() can read them at startup.
         No EmbeddedResource — we want them on-disk so the IngestPipeline
         sees the same byte layout the real ingest path does. -->
    <Content Include="SeedData/vb6-inventory-sample/**/*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

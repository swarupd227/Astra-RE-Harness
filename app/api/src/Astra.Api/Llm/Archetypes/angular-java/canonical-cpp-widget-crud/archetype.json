{
  "$schema": "https://astra.nous.ai/archetype/v1",
  "id": "canonical-cpp-widget-crud",
  "targetStack": "angular-java",
  "displayName": "C++ REST resource -> Angular + Spring Boot 3",
  "description": "Reference C++-to-Angular+Java scaffold for a routine that exposes a list/create/delete resource. Produces two paired, independently buildable packages: a Spring Boot 3 Web API (WidgetRecordPort for data access, WidgetService for business rules, WidgetController for HTTP) and an Angular 18 standalone-component app (WidgetService calling the API, WidgetListComponent rendering it) with Jest unit tests on both the service and component -- the same shape as angular-dotnet8/canonical-delphi-angular-widget-crud, just with a Spring Boot backend instead of ASP.NET Core. CompileValidator builds and tests each half with its own toolchain (mvn -o test-compile/test via the maven sidecar for backend/, npm ci + ng build + jest for frontend/) and reports one combined result. Unlike every other java-spring-family archetype, this one is NOT framework-free -- it depends on real spring-boot-starter-web, which the maven-sidecar's offline cache now bakes in specifically to support this stack.",
  "compatibleSchemas": ["cpp"],

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <LangVersion>14.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Demo.OrderEntry</RootNamespace>
    <AssemblyName>Demo.OrderEntry</AssemblyName>
    <!-- Phase 10.3 — exclude tests/ from main project's implicit globs.
         Tests project (tests/Demo.OrderEntry.Tests.csproj) has its own
         xunit reference; leaving the default <Compile Include="**/*.cs" />
         picks up test files in the main build and fails. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**</DefaultItemExcludes>
    <Description>
      Reference .NET 10 / WinForms scaffold for VB6 thick-client form apps, generated
      from a signed VB6 spec (spec/v1, schemaId=vb6, target_archetype_hint=WinForms).
      Form lives in src/OrderEntryForm.cs; the EF Core data layer in
      src/OrderRepository.cs; the Excel exporter in src/InvoiceExporter.cs (ClosedXML,
      not Excel Interop). Every public surface carries a [SpecClaim(...)] attribute
      citing the signed claim id so the scaffold ties back to the spec.

      Targets net10.0-windows because WinForms requires the Windows-specific runtime
      bundle. Use the dotnet10-blazor or dotnet10-minapi sibling archetype for code
      that should leave the desktop.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.0" />
    <PackageReference Include="ClosedXML" Version="0.105.0" />
  </ItemGroup>
</Project>

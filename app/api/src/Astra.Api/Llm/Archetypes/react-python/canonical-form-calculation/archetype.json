{
  "$schema": "https://astra.nous.ai/archetype/v1",
  "id": "canonical-form-calculation",
  "targetStack": "react-python",
  "displayName": "Form-driven calculation -> React + Python (FastAPI)",
  "description": "Reference scaffold for a routine behind a form: the user fills in inputs that have rules (allowed values, ranges), presses a button, and the routine looks values up in a table, calculates a result and may record it — the shape of most spreadsheet macros and desktop forms. Produces two paired, independently buildable packages: a FastAPI back end (pydantic models carrying the input rules, a RatePort lookup with an in-memory table standing in for the sheet it came from, a CalculationService for the business rules, an APIRouter for HTTP) with pytest tests on the service and the routes, and a React 18 + Vite + TypeScript front end (types mirroring the models, an api module with one function per route, a CalculationForm component that checks the same rules before calling the API) with Jest + Testing Library tests. CompileValidator builds each half with its own toolchain (pip install + compileall + import for backend/, npm install + tsc + vite build for frontend/); TestPackValidator runs pytest and jest and reports one combined result.",
  "compatibleSchemas": ["vb6", "vbnet", "csharp", "delphi", "cpp"],

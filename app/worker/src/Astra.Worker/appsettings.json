{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Hangfire": "Information"
      }
    }
  },
  "AllowedHosts": "*",
  "Hangfire": {
    "DashboardEnabled": true,
    "SchedulePingJob": true
  }
}

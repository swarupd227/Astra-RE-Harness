# Phase 10.0.f — vb6-sidecar dev tier per ADR-037.
#
# Debian + Wine fallback. Lets the Linux-first dev team work on
# 10.0.a / 10.0.b / 10.0.c / 10.0.d / 10.0.g / 10.0.h without
# standing up a Windows host. Covers non-COM routines reliably;
# COM-heavy code surfaces structured "tier=wine" warnings on /run
# results so the validator can mark Gate 3 as "skipped (dev-tier)".
#
# Customer still drops vb6.exe + msvbvm60.dll + oleaut32.dll +
# stdole2.tlb into the /runtime volume at deploy time. Wine's
# regsvr32 registers msvbvm60 at container start.

FROM debian:bookworm-slim AS base

WORKDIR /app

# Wine 9-stable plus the 32-bit support library (vb6.exe is x86).
RUN dpkg --add-architecture i386 \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
        ca-certificates \
        gnupg \
        wget \
        curl \
        python3 \
        python3-pip \
        python3-venv \
        wine \
        wine32 \
        winbind \
 && rm -rf /var/lib/apt/lists/*

# Phase 10.3.c — install .NET 10 SDK so the dev tier can run a
# VB.NET reference instead of vb6.exe. Wine's builtin cscript is a
# stub that returns exit 1 with no output, and winetricks wsh57
# pulls licensed Microsoft binaries (same constraint the original
# vb6.exe path was trying to avoid). VB.NET sources LOOK like VB6
# (Option Explicit, Dim As Long, CLng, Currency, etc.) and run
# natively on .NET 10 — closes the runtime-licence gap without
# changing what the validator says about the language family.
RUN curl -sSL https://dot.net/v1/dotnet-install.sh -o /tmp/dotnet-install.sh \
 && chmod +x /tmp/dotnet-install.sh \
 && /tmp/dotnet-install.sh --channel 10.0 --quality preview --install-dir /usr/share/dotnet \
 && rm /tmp/dotnet-install.sh \
 && ln -s /usr/share/dotnet/dotnet /usr/local/bin/dotnet \
 && dotnet --list-sdks

# FastAPI server deps in a venv.
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
RUN pip install --no-cache-dir \
        "fastapi==0.115.5" \
        "uvicorn[standard]==0.32.1"

# Wine prefix: configured at first invocation. We seed it now so the
# first /compile call doesn't pay the wineprefix-init latency.
ENV WINEPREFIX=/root/.wine \
    WINEARCH=win32 \
    WINEDEBUG=-all

RUN winecfg /v win7 || true   # initialise the prefix; the err exit is benign

COPY vb6_sidecar/ vb6_sidecar/

# Entrypoint script registers msvbvm60.dll (if present in /runtime) then
# launches the server. Registration is idempotent across restarts.
COPY entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

ENV PYTHONUNBUFFERED=1 \
    VB6_PORT=51058 \
    VB6_WORKDIR=/var/tmp/vb6-runs \
    VB6_RUNTIME_DIR=/runtime \
    VB6_TIER=wine

EXPOSE 51058

HEALTHCHECK --interval=10s --timeout=5s --retries=5 \
    CMD python3 -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://localhost:51058/health', timeout=2).status==200 else 1)"

CMD ["/app/entrypoint.sh"]

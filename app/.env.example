# Astra RE Harness — local Docker environment
# Copy this file to .env and adjust if needed. .env is gitignored.
#
# Host-port namespace: 3xxxx, picked to coexist with other dev stacks
# on the same host:
#   atlas-* uses 28xxx
#   nhep-*  uses 18xxx / 19xxx
#   cude-*  uses default (5432, 9000, 9001, 8080, ...)
#   astra-* uses 3xxxx  ← this project
# Container-internal ports are unchanged; only host-side bindings move.

# ───── Postgres ─────────────────────────────────────────────────────────
POSTGRES_USER=astra
POSTGRES_PASSWORD=astra_dev_pw
POSTGRES_DB=astra
POSTGRES_PORT=38432

# ───── MinIO (S3-compatible blob store) ─────────────────────────────────
MINIO_ROOT_USER=astra
MINIO_ROOT_PASSWORD=astra_dev_pw
MINIO_PORT=39000
MINIO_CONSOLE_PORT=39001
# Buckets created by the bootstrap container at first run
MINIO_BUCKET_SOURCES=sources
MINIO_BUCKET_SIGNED_SPECS=signed-specs
MINIO_BUCKET_SCAFFOLDS=scaffolds
MINIO_BUCKET_LLM_DEBUG=llm-debug-restricted

# ───── API ──────────────────────────────────────────────────────────────
API_PORT=38080
ASPNETCORE_ENVIRONMENT=Development
# Dev-only: bypasses authentication, reads X-Dev-Persona header.
# DO NOT enable in any deployed environment.
DEV_PERSONA_BYPASS=true
# Default persona used when X-Dev-Persona header is absent
DEV_PERSONA_DEFAULT=engineer
# The 66-LOC CONSUME_ROLL synthetic seed defaults OFF so the Projects
# dashboard opens on real Fortran corpora. Flip to true if you need it
# (existing e2e suites that pin spec claims to CONSUME_ROLL invariants).
DATABASE_SEED_DEMO=false
# Auto-ingest MINPACK (https://github.com/certik/minpack) on boot + after
# every /dev/reset so the demo opens against a real ~10k-LOC corpus.
DATABASE_SEED_MINPACK=true
# Auto-ingest LAPACK Reference BLAS (https://github.com/Reference-LAPACK/lapack
# BLAS/SRC subdirectory) — ~140 routines, ~25k LOC of dense linear-algebra
# kernels. Second substantial Fortran corpus next to MINPACK.
DATABASE_SEED_LAPACK_BLAS=true

# ───── Worker ───────────────────────────────────────────────────────────
HANGFIRE_DASHBOARD_PORT=38081

# ───── Parser sidecar ───────────────────────────────────────────────────
PARSER_PORT=50051

# ───── Frontend ─────────────────────────────────────────────────────────
FRONTEND_PORT=35173
# URL the browser hits to reach the API. Goes through compose's published port.
VITE_API_BASE_URL=http://localhost:38080

# ───── LLM providers ────────────────────────────────────────────────────
# Stage-3 (extraction) provider: mock | fail-mock | anthropic.
#   mock       — offline canonical CONSUME_ROLL spec; safe for any environment.
#   fail-mock  — chaos-rehearsal helper that errors mid-stream after stage 3.
#   anthropic  — real Claude. Falls back to mock at startup with a warning if
#                ANTHROPIC_API_KEY is empty, so a fresh clone never breaks.
LLM_PROVIDER=mock

# Stage-5 (scaffold) provider — currently mock-only; Azure OpenAI lands in
# a later phase. Symmetric variable for forward compatibility.
LLM_SCAFFOLD_PROVIDER=mock

# Anthropic configuration. Only required when LLM_PROVIDER=anthropic.
# Get a key from https://console.anthropic.com — use the no-train,
# no-retention enterprise endpoint in production.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MAX_OUTPUT_TOKENS=8192

# ───── Observability (optional, enabled via --profile observability) ────
OTEL_COLLECTOR_GRPC_PORT=34317
OTEL_COLLECTOR_HTTP_PORT=34318
JAEGER_UI_PORT=36686

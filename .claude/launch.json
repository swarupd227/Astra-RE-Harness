{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "app/frontend"],
      "port": 5173
    },
    {
      "name": "frontend-localapi",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "cd app\\frontend && npx vite --mode localapi --host localhost --port 35173 --strictPort"],
      "port": 35173,
      "url": "http://localhost:35173"
    }
  ]
}
